    "@tanstack/react-query": "^5.101.0",
    "@types/dompurify": "^3.0.5",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.11",
