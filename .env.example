VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Webhook URLs (n8n / Telegram)
VITE_WEBHOOK_BASE_URL=https://your-n8n.app/webhook

# Catalog assets base URL (Cloudflare R2 custom domain). Empty = serve from Supabase Storage.
VITE_ASSETS_BASE_URL=

# §274. Хост pull-зоны библиотеки Bunny Stream (vz-xxxxxxxx-xxx.b-cdn.net) — обложки видео на карточках уроков.
# Пусто = вместо обложек заглушка с номером урока.
VITE_BUNNY_CDN_HOST=
